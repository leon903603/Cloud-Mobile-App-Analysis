{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmaa.islab/schemas/static_report_v1.schema.json",
  "title": "CMAA Cross-Engine Static Analysis Report Contract v1",
  "version": "1.0.0",
  "description": "Defines the static analysis report contract between android-static, cloud platform, and pdf-generator.",
  "invariants": {
    "whiteLabel": {
      "forbiddenFieldsNonEmpty": ["mas", "mast"],
      "forbiddenSubstringsInDesc": ["mas.owasp.org"],
      "requiredLatestRuleIds": ["AS-lab084", "AS-lab085", "AS-lab086", "AS-lab087"],
      "minRuleCount": 80
    },
    "pdfSafety": {
      "maxDetailChars": 3000
    }
  },
  "definitions": {
    "RuleMetadata": {
      "required": ["title", "level", "desc"],
      "allowedLevels": ["CRITICAL", "HIGH", "MEDIUM", "WARNING", "LOW", "NOTICE", "INFO", "PASS", "FAIL", "NOT_EVALUATED"]
    },
    "FindingEntry": {
      "required": ["isDetected", "data"]
    }
  }
}
